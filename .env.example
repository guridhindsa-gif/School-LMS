# ---- Ollama (AI tutor, lessons, adaptive questions) ----
# Option A: Ollama Cloud — paste your key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
# OLLAMA_HOST defaults to https://ollama.com when a key is set, otherwise to your local Ollama.
# Option B: local Ollama (ollama serve) — no key needed
# OLLAMA_HOST=http://127.0.0.1:11434

# Model used for the tutor, lessons and questions.
# Cloud examples: gpt-oss:20b, gpt-oss:120b, qwen3-coder:480b   Local examples: llama3.1:8b, qwen2.5:7b, gemma2:9b
OLLAMA_MODEL=gpt-oss:20b
# Optional: a faster/smaller model for quick tasks (hints, short answers). Falls back to OLLAMA_MODEL.
OLLAMA_FAST_MODEL=

# ---- Optional: Claude instead of Ollama ----
# Users can add their own Claude API key in Settings & AI (kept on their device, sent per request).
# To make Claude the school-wide AI instead, set both:
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5   # or claude-haiku-5-5, claude-opus-5-5
